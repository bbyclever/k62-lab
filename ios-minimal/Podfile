# Official FitCloudPro SDK (https://github.com/htangsmart/FitCloudPro-SDK-iOS),
# cloned into Vendor/ by the CI workflow, integrated like its FitCloudSwiftDemo.
platform :ios, '16.0'
inhibit_all_warnings!

target 'K62Minimal' do
  sdk = 'Vendor/FitCloudPro-SDK-iOS'
  pod 'FitCloudKit', :path => sdk
  pod 'FitCloudKit/WhatsApp', :path => sdk
  pod 'FitCloudDFUKit', :path => sdk
  pod 'FitCloudWFKit', :path => sdk
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
    end
  end
end
